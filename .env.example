# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tatuzinho_dev
DB_POOL_SIZE=20
DB_POOL_RECYCLE=3600

# FastAPI
DEBUG=True
ENV=development
LOG_LEVEL=INFO

# Scraping
SCRAPER_ENABLED=True
BACKFILL_ENABLED=False
BACKFILL_YEARS=2

# Predictions
PREDICTION_MODEL_PATH=/tmp/prediction_model.pkl
MIN_HISTORICAL_MATCHES=5

# AI match analysis (optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_ANALYSIS_MODEL=gpt-4.1-mini
AI_WEB_SEARCH_ENABLED=True
AI_ANALYSIS_TIMEOUT_SECONDS=45
